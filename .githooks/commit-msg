#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
SUBJECT="$(sed -n '1p' "$MSG_FILE")"

# 1. Conventional Commits prefix + Capitalized imperative verb
if [[ ! "$SUBJECT" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?:[[:space:]][A-Z] ]]; then
    echo "[commit-msg] ERROR: Subject must follow Conventional Commits and start with a capitalized verb:" >&2
    echo "  e.g., 'feat: Add experience system' (got: '$SUBJECT')" >&2
    exit 1
fi

# 2. 50/72 Rule enforcement
if (( ${#SUBJECT} > 50 )); then
    echo "[commit-msg] ERROR: Subject line exceeds 50 characters (${#SUBJECT} chars):" >&2
    echo "  $SUBJECT" >&2
    exit 1
fi

SECOND_LINE="$(sed -n '2p' "$MSG_FILE")"
if [[ -n "$SECOND_LINE" ]]; then
    echo "[commit-msg] ERROR: Line 2 of commit message must be blank." >&2
    exit 1
fi

line_no=0
while IFS= read -r line; do
    ((line_no++)) || true
    [[ $line_no -le 2 || "$line" =~ ^# ]] && continue
    if (( ${#line} > 72 )); then
        echo "[commit-msg] ERROR: Body line $line_no exceeds 72 characters (${#line} chars):" >&2
        echo "  $line" >&2
        exit 1
    fi
done < "$MSG_FILE"
